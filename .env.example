# Backend configuration (copy to backend/.env for local dev)
APP_NAME="Weather Tracking & Analysis Dashboard"
ENVIRONMENT=development
DATABASE_URL=sqlite:///./weather.db

# External weather providers (see WBS 1.1.1)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org

# Ingestion / polling (WBS 1.1.2)
POLL_INTERVAL_SECONDS=900
